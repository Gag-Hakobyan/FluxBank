<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Spring Boot default console -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- ===================== -->
    <!-- CONSOLE -->
    <!-- ===================== -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- ===================== -->
    <!-- MAIN LOG (PRO STYLE) -->
    <!-- ===================== -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">

        <!-- один текущий файл -->
        <file>logs/StudentManagement.log</file>

        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>

        <!-- 🔥 ДАТА (по дням) + РАЗМЕР -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">

            <!-- ОДИН ДЕНЬ = ОДИН НАБОР ФАЙЛОВ -->
            <fileNamePattern>
                logs/StudentManagement-%d{yyyy-MM-dd}.%i.log
            </fileNamePattern>

            <!-- лимит размера -->
            <maxFileSize>10MB</maxFileSize>

            <!-- хранить 14 дней -->
            <maxHistory>14</maxHistory>

        </rollingPolicy>

    </appender>

    <!-- ===================== -->
    <!-- ERROR LOG -->
    <!-- ===================== -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">

        <file>logs/StudentManagement-error.log</file>

        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>

        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level %logger{36} - %msg%n%ex</pattern>
        </encoder>

        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>
                logs/StudentManagement-error-%d{yyyy-MM-dd}.log
            </fileNamePattern>
            <maxHistory>14</maxHistory>
        </rollingPolicy>

    </appender>

    <!-- ===================== -->
    <!-- ROOT LOGGER -->
    <!-- ===================== -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </root>

</configuration>